#!/usr/bin/env bash
# Telemachus Linux scout launcher: pick a Tailscale host in a tkinter window.
set -euo pipefail
# Resolve symlinks: scripts/install-linux.sh links this into ~/.local/bin, and
# `$0` would otherwise point at the link, breaking the package import below.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$here"
uv_bin="${UV_BIN:-$(command -v uv || true)}"
exec "${uv_bin:-$HOME/.local/bin/uv}" run --frozen --no-dev python -m telemachus_client.scout "$@"
